# ── App ───────────────────────────────────────────
APP_NAME=Flowlog
APP_ENV=development                 # development | staging | production

# ── Supabase ──────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server/edge functions only, never client

# ── Transcription Provider ────────────────────────
# NOTE: In production the pipeline runs in the `process-session` Supabase edge
# function. API secrets live THERE (set via `supabase secrets set ...`), NOT in
# the client. Expo only ships EXPO_PUBLIC_* vars to the app, so these keys are
# intentionally absent on the client. The values below are used only by the
# unit-tested reference pipeline in `src/` (e.g. when running tests).
TRANSCRIPTION_PROVIDER=whisper      # whisper | assemblyai | deepgram
OPENAI_API_KEY=                     # Whisper — server-side (supabase secrets set)
ASSEMBLYAI_API_KEY=                 # future
DEEPGRAM_API_KEY=                   # future

# ── AI Provider ───────────────────────────────────
AI_PROVIDER=claude                  # claude | openai | gemini
ANTHROPIC_API_KEY=                  # Claude — server-side (supabase secrets set)
OPENAI_CHAT_API_KEY=                # OpenAI provider
GEMINI_API_KEY=                     # Gemini — server-side (supabase secrets set)
# GEMINI_MODEL override (default gemini-2.5-flash; try gemini-2.5-pro):
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-pro

# ── Payments ──────────────────────────────────────
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
STRIPE_PUBLISHABLE_KEY=

# ── Pipeline Tuning ───────────────────────────────
COACHING_CUE_MAX_WORDS=25
QUALITY_GATE_ENABLED=true
QUALITY_GATE_RETRY_LIMIT=2
MAX_RECORDING_SECONDS=90
MIN_RECORDING_SECONDS=20

# ── Feature Flags ─────────────────────────────────
FEATURE_TREND_ANALYSIS=false        # unlocks after 10 sessions
FEATURE_GAME_PROFILE=false          # unlocks after 10 sessions
FEATURE_SOCIAL=false                # not in MVP
FEATURE_VIDEO_INTEGRATION=false     # not in MVP
FEATURE_GOLF_SPORT=false            # not in MVP

# ── Prototyping ───────────────────────────────────
EXPO_PUBLIC_DEMO_MODE=false         # true = canned pipeline results, fully offline (no keys/backend)

# ── Local TEST pipeline (LOCAL TESTING ONLY) ──────
# When true, the app runs the real Whisper + Claude pipeline directly in the
# client using the keys below — no Supabase, no edge function. The keys ship in
# the client bundle, so NEVER enable this in a real/published build. Demo mode
# takes precedence if both are on.
EXPO_PUBLIC_LOCAL_PIPELINE=false
EXPO_PUBLIC_TRANSCRIPTION_PROVIDER=whisper  # whisper | gemini (gemini = no OpenAI needed)
EXPO_PUBLIC_AI_PROVIDER=claude      # claude | gemini  (which AI runs the analysis)
EXPO_PUBLIC_OPENAI_API_KEY=         # sk-...   (Whisper) — if TRANSCRIPTION_PROVIDER=whisper
EXPO_PUBLIC_ANTHROPIC_API_KEY=      # sk-ant-... (Claude) — if AI_PROVIDER=claude
EXPO_PUBLIC_GEMINI_API_KEY=         # AIza...  (Gemini) — used for transcription and/or AI
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-pro   # optional, default gemini-2.5-flash
