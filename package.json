{
  "name": "flowlog",
  "version": "0.2.0",
  "main": "./index.js",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "description": "Flowlog \u2014 a voice reflection tool for serious hobbyists. Talk. Reflect. Improve.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "deploy:web": "expo export --platform web && node scripts/web/after-export.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^54.0.0",
    "expo-av": "~16.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.8",
    "expo-file-system": "~19.0.14",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.11",
    "expo-web-browser": "~15.0.7",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.3.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.8.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.106.0",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.9.2"
  }
}
