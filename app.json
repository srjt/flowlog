{
  "expo": {
    "name": "Flowlog",
    "slug": "flowlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "flowlog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.flowlog.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Flowlog records a short voice reflection after your training session.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.flowlog.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Flowlog records a short voice reflection after your training session."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B8DEF"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c76e4bb3-89c5-49bb-8953-e3eed50ef545"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/c76e4bb3-89c5-49bb-8953-e3eed50ef545"
    }
  }
}
